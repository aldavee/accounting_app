<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Accounting App"
      Manufacturer="AldaveLabs"
      Version="$(var.MsiVersion)"
      UpgradeCode="E7A1B3C5-92D4-4E8F-B6A1-3C9D0E2F5A81"
      Scope="perMachine"
      InstallerVersion="500">

    <SummaryInformation
        Description="Accounting App - Double-Entry Accounting Fundamentals &amp; Financial Statements" />

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of [ProductName] is already installed."
        Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://accounting.aldavelabs.com" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Accounting App" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Accounting App" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.SourceDir)\**" />
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts">
      <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="*">
        <Shortcut
            Id="ApplicationStartMenuShortcut"
            Name="Accounting App"
            Description="Accounting App Desktop Workspace"
            Target="[INSTALLFOLDER]accounting_app.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon.ico" />
        <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
        <RegistryValue
            Root="HKCU"
            Key="Software\AldaveLabs\AccountingApp"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="*">
        <Shortcut
            Id="DesktopShortcut"
            Name="Accounting App"
            Description="Accounting App Desktop Workspace"
            Target="[INSTALLFOLDER]accounting_app.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon.ico" />
        <RegistryValue
            Root="HKCU"
            Key="Software\AldaveLabs\AccountingApp"
            Name="DesktopShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="ProductFeature" Title="Accounting App" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>
  </Package>
</Wix>
